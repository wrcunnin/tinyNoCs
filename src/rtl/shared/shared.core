CAPI=2:
name: tinynocs:src:rtl-shared:0.0.1
description: Shared RTL modules for NoC components

filesets:
  packages:
    files:
      - packages/packet_pkg.sv
    file_type: systemVerilogSource

  endpoint:
    files:
      - endpoint/endpoint_rx_arbiter.sv
      - endpoint/endpoint_tx_arbiter.sv
      - endpoint/endpoint.sv
    file_type: systemVerilogSource

  fifo_basic:
    files:
      - fifo/fifo_basic.sv
    file_type: systemVerilogSource

  fifo_rob:
    files:
      - fifo/fifo_rob.sv
    file_type: systemVerilogSource

  # Put specifically defined macros here
  fifo_basic_w64_d32:
    depend:
      - fifo_basic
    files:
      - fifo/fifo_basic_w64_d32.sv
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - packages
      - endpoint
      - fifo_basic
      - fifo_rob
      - fifo_basic_w64_d32
